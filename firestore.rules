rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to validate string size
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: mitra (Master profil sekolah)
    match /mitra/{mitraId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: laporan_bulanan
    match /laporan_bulanan/{laporanId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: pembayaran
    match /pembayaran/{pembayaranId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: permintaan_mitra
    match /permintaan_mitra/{permintaanId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: staff_activities
    match /staff_activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: templates
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: performance_mendaki
    match /performance_mendaki/{evalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
