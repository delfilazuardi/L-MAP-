rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Collection: users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collection: mitra (Master profil sekolah)
    match /mitra/{mitraId} {
      allow read, write: if true;
    }

    // Collection: laporan_bulanan
    match /laporan_bulanan/{laporanId} {
      allow read, write: if true;
    }

    // Collection: invoices
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Collection: pembayaran
    match /pembayaran/{pembayaranId} {
      allow read, write: if true;
    }

    // Collection: events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Collection: permintaan_mitra
    match /permintaan_mitra/{permintaanId} {
      allow read, write: if true;
    }

    // Collection: staff_activities
    match /staff_activities/{activityId} {
      allow read, write: if true;
    }

    // Collection: admin_staff
    match /admin_staff/{staffId} {
      allow read, write: if true;
    }

    // Collection: templates
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Collection: performance_mendaki
    match /performance_mendaki/{evalId} {
      allow read, write: if true;
    }
  }
}

